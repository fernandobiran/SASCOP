    <script>
        // LÓGICA DE ZOOM Y PAN (Arrastrar)
        let scale = 0.8; // Zoom inicial un poco alejado para ver más
        const zoomWrapper = document.getElementById('zoom-wrapper');
        const container = document.getElementById('org-container');
        
        // Aplicar zoom inicial
        updateZoom();

        function zoomIn() {
            scale += 0.1;
            updateZoom();
        }

        function zoomOut() {
            if (scale > 0.2) scale -= 0.1;
            updateZoom();
        }

        function updateZoom() {
            zoomWrapper.style.transform = `scale(${scale})`;
        }

        // Lógica de Arrastrar (Pan)
        let isDown = false;
        let startX;
        let scrollLeft;
        let startY;
        let scrollTop;

        container.addEventListener('mousedown', (e) => {
            isDown = true;
            container.classList.add('active');
            startX = e.pageX - container.offsetLeft;
            scrollLeft = container.scrollLeft;
            startY = e.pageY - container.offsetTop;
            scrollTop = container.scrollTop;
        });

        container.addEventListener('mouseleave', () => {
            isDown = false;
            container.classList.remove('active');
        });

        container.addEventListener('mouseup', () => {
            isDown = false;
            container.classList.remove('active');
        });

        container.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - container.offsetLeft;
            const walkX = (x - startX) * 2; // Velocidad de scroll
            container.scrollLeft = scrollLeft - walkX;
            
            const y = e.pageY - container.offsetTop;
            const walkY = (y - startY) * 2;
            container.scrollTop = scrollTop - walkY;
        });
    </script>

